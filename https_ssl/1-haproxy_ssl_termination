global
    log /dev/log local0
    log /dev/log local1 notice
    chroot /var/lib/haproxy
    stats socket /run/haproxy/admin.sock mode 660 level admin expose-fd listeners
    stats timeout 30s
    user haproxy
    group haproxy
    daemon
    maxconn 2048
    tune.ssl.default-dh-param 2048

defaults
    log     global
    mode    http
    option  httplog
    option  dontlognull
    timeout connect 5000
    timeout client  50000
    timeout server  50000

frontend www-http
    bind *:80
    default_backend web-backend

frontend www-https
    bind *:443 ssl crt /etc/haproxy/certs/www.kezajoyeuse.tech.pem
    default_backend web-backend

backend web-backend
    balance roundrobin
    server 7323-web-01 52.56.201.56:80 check
    server 7323-web-02 35.176.110.16:80 check
